# Copy this file to .env and fill in your values.
# .env is never committed — it is listed in .gitignore.
#
# These are OPTIONAL overrides. The app collects all paths via the GUI
# input screen on first run and saves them to config/settings.json.
# Only set these if you want to pre-seed the defaults programmatically
# (e.g. in a CI/test environment).

RAW_FILE=C:\path\to\your\data.xlsx
SHEET_NAME=Sheet1
HOSTNAME_COL=Hostname
OUTPUT_FILE=C:\path\to\output.xlsx
NUM_ROWS=all
